---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }} — Writing</title>
  <subtitle>{{ site.description | strip_newlines | strip }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/" rel="alternate" type="text/html"/>
  <id>{{ site.url }}/</id>
  {%- assign posts = site.blog | sort: 'date' | reverse -%}
  {%- if posts.size > 0 %}
  <updated>{{ posts[0].date | date_to_xmlschema }}</updated>
  {%- else %}
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  {%- endif %}
  <author><name>{{ site.author }}</name></author>
  {%- for p in posts %}
  <entry>
    <title type="html">{{ p.title | xml_escape }}</title>
    <link href="{{ p.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ p.url | absolute_url }}</id>
    <published>{{ p.date | date_to_xmlschema }}</published>
    <updated>{{ p.date | date_to_xmlschema }}</updated>
    {%- if p.category %}<category term="{{ p.category | xml_escape }}"/>{% endif %}
    <summary type="html">{{ p.description | xml_escape }}</summary>
    <content type="html">{{ p.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
